{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Warm-AntiCheat Contest Builder",
  "version": "0.3.0",
  "identifier": "com.warmanticheat.builder",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Warm-AntiCheat Contest Builder",
        "width": 1200,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 Kasra Borjloo. Licensed under GPL-3.0.",
    "shortDescription": "Offline-First Anti-Cheat Contest Builder",
    "longDescription": "Desktop application used by organizers to configure, brand, and generate customized offline competition integrity clients with cryptographic keypairs and manifests."
  }
}
