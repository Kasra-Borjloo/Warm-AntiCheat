{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Warm-AntiCheat Participant Client",
  "version": "0.7.0",
  "identifier": "com.warmanticheat.participant",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Warm-AntiCheat Participant Client",
        "width": 1100,
        "height": 780,
        "minWidth": 750,
        "minHeight": 550,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 Kasra Borjloo. Licensed under GPL-3.0.",
    "shortDescription": "Offline-First Anti-Cheat Participant Client",
    "longDescription": "Desktop application running on participant workstations during programming competitions, recording tamper-evident audit chains with asymmetric encryption."
  }
}
